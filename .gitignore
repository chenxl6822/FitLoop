# AI working docs and task specs — never commit
.tmp*/
**/CLAUDE_CONTEXT.md
mobile/README.md
**/task*_spec.md
**/task*_spec/**
docs/PHASE1_HANDOFF.md
docs/*_summary.md

# Cross-project files
docs/Table-Miku*

# Local interview preparation documents
docs/PROJECT_STAR_INTERVIEW_PLAYBOOK.md
docs/INTERVIEW_GUIDE.md

# Local course deliverables and source documents stay outside Git.
*.docx
*.pptx
*.xlsx
*.pdf
local-docs/
reports/
submission/

# Environment and secrets
.env
.env.*
!.env.example
application-local.yml

# Java / Spring Boot
/build/
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Flutter / Dart
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.packages

# Release artifacts and metadata are published outside Git.
deploy/apk/*.apk
deploy/apk/*.apk.sha256
deploy/apk/version.json
deploy/apk/*.previous
deploy/apk/releases/
deploy/apk/states/
deploy/apk/active
deploy/apk/.install.lock
deploy/apk/.install.*
deploy/certbot-www/*
!deploy/certbot-www/.gitkeep

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
*.iml
.DS_Store
Thumbs.db
*.patch

# Local one-off deploy/debug helpers and logs (never commit)
scripts/_*
scripts/capture-campus-log.ps1
